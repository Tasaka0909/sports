<h2>プロフィール編集</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "users/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :name,"名前" %><br />
    <%= f.text_field :name, autofocus: true, autocomplete: "name" %>
  </div>

  <div class="field">
    <%= f.label :image,"画像" %>
    <%= f.file_field :image %>
  </div>

  <div class="field">
    <%= f.label :profile,"プロフィール" %><br />
    <%= f.text_area :profile, autofocus: true %>
  </div>


  <div class="field">
    <p><%= f.label :email,"メールアドレス" %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="field">
    <p><%= f.label :current_password,"現在のパスワード" %> <i>(情報を更新するために必要です)</i></p>
    <p><%= f.password_field :current_password, autocomplete: "current-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password,"パスワード" %> <i>(変更しない場合は空欄のままにしてください)</i></p>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
    <% if @minimum_password_length %>
    <p><em>最低<%= @minimum_password_length %>文字</em></p>
    <% end %>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation,"パスワード確認用" %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit "更新する" %>
  </div>
<% end %>

<div>
  <%= button_to "アカウントを解約する", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete %>
</div>

<%= link_to "戻る", :back, class: "profile-back-btn" %>
