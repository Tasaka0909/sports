<h2>会員登録</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :名前 %><br />
    <%= f.text_field :name, autofocus: true %>

  

  <div class="field">
    <p><%= f.label :メールアドレス %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <div class="field"> 
  <div class="password-label-row">
    <%= f.label :パスワード %>

    <% if @minimum_password_length %> 
      <span class="password-hint">
        最低<%= @minimum_password_length %>文字
      </span> 
    <% end %>
  </div>

  <p>
    <%= f.password_field :password, autocomplete: "new-password" %>
  </p> 
</div>

  <div class="field">
   <p><%= f.label :パスワードを確認する %></p>
   <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit "会員登録" %>
  </div>
<% end %>

<%= render "users/shared/links" %>
